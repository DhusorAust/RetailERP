@{
    var version = Guid.NewGuid().ToString();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section section_top
{
    <script type="text/javascript">
        localStorage.setItem("pageName", "@ViewBag.PageName");
        localStorage.setItem("menuId", "@ViewBag.MenuId");
    </script>

    <style>
        #tblPIInformation-71 {
            font-size: 12px;
        }

        #tblChild2PIInfo-1543, #tblChild3PIInfo-1543, #tblPIInfo-1543, #tblPIInfo_Audit-1891 {
            font-size: 12px;
        }

        .form-group label {
            font-size: 12px !important;
            font-weight: 400;
        }
    </style>
}

@{
    var pageId = ViewBag.PageName + "-" + ViewBag.MenuId;
    var divToolbarId = "divtoolbar" + pageId;
    var toolbarId = "toolbar" + pageId;
    var tblMasterId = "tbl" + pageId;
    var tblChildId = "tblChild" + pageId;
    var tblChildId2 = "tblChild2" + pageId;
    var tblChildId3 = "tblChild3" + pageId;
    var formId = "form" + pageId;
    var divDetailsId = "divDetails" + pageId;
}

<div class="d-flex flex-column-fluid" id="@pageId">
    <input type="hidden" id="ApprovePage" value="@ViewBag.ApprovePage" /> 

    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-custom gutter-b example example-compact" style="padding-top:10px; border-radius:0px !important;">
                    <div id="@divToolbarId">
                        <div class="row">
                            <div class="col-lg-12">
                                <div id="@toolbarId"> 
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px; display: none;" id="btnNewAdd">
                                        <i class="fa fa-plus"></i>&nbsp;New Add
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px; display: none1;" id="btnEditList">
                                        <i class="fa fa-list"></i>&nbsp;Temp List
                                    </div> 
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px; display: none1;" id="btnApprovedList">
                                        <i class="fa fa-list"></i>&nbsp;Approved List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px; display: none1;" id="btnRejectList">
                                        <i class="fa fa-list"></i>&nbsp;Reject List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px; display: none1;" id="btnAllList">
                                        <i class="fa fa-list"></i>&nbsp;All List
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div id="@tblMasterId"></div>
                            </div>
                        </div>
                    </div>

                    <form class="form" id="@formId">

                        <input type="hidden" id="BuyerRefMasterID" name="BuyerRefMasterID" value="0" />
                        <input type="hidden" id="FinishedProductCategoryID" name="FinishedProductCategoryID" value="0" />
                        <input type="hidden" id="FinishedProductTypeID" name="FinishedProductTypeID" value="0" />

                        <input type="hidden" id="DepartmentID" name="DepartmentID" value="0" />
                        <input type="hidden" id="SectionID" name="SectionID" value="0" />
                        <input type="hidden" id="SubSectionID" name="SubSectionID" value="0" />

                        <div class="card-body" id="@divDetailsId" style="display:none">
                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary"> </i> &nbsp; General Information
                                </h6>
                            </div>

                            <div class="k-block p-4" style="border:1px solid #008093; border-radius:0px !important;"> 
                                <div class="row">
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Chemical Code</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" style="font-weight:700 !important;" placeholder="" id="ChemicalCode" name="ChemicalCode" disabled />
                                                    <span class="form-text text-muted ChemicalCode">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Brand Ref.</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" style="font-weight:700 !important;" placeholder="" id="BuyerRef" name="BuyerRef" />
                                                    <span class="form-text text-muted BuyerRef">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Brand</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="BuyerID" name="BuyerID" style="width:100%; " />
                                                    <span class="form-text text-muted BuyerID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Finished Product</label>
                                                <div class="right-col kendo_combobox">
                                                    <input type="text" id="FinishedProductID" name="FinishedProductID" style="width: 100%;" tabindex="10" />
                                                    <span class="form-text text-muted FinishedProductID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Product Category</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" style="font-weight:700 !important;" placeholder="" id="ProductCategoryName" name="ProductCategoryName" disabled />
                                                    <span class="form-text text-muted ProductCategoryName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Product Type</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" style="font-weight:700 !important;" placeholder="" id="ProductTypeName" name="ProductTypeName" disabled />
                                                    <span class="form-text text-muted ProductTypeName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right"> Color</label>
                                                <div class="right-col multi_select multi_select_multicolumn">
                                                    <input id="ColorID" name="ColorID" style="width:100%" />
                                                    <span class="form-text text-muted ColorID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Ref. Date</label>
                                                <div class="right-col">
                                                    <input type="text" class="w-100" kendorole="kendodatepicker" placeholder="dd-MMM-yyyy" id="BuyerRefDate" name="BuyerRefDate" autocomplete="off"  />
                                                    <span class="form-text text-muted BuyerRefDate">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Season</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="SeasonID" name="SeasonID" style="width:100%; " />
                                                    <span class="form-text text-muted SeasonID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Marketing Person</label>
                                                <div class="right-col kendo_combobox">
                                                    <input type="text" id="MarketingPersonID" name="MarketingPersonID" style="width: 100%;" tabindex="10" />
                                                    <span class="form-text text-muted MarketingPersonID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                    @* <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Color</label>
                                                <div class="right-col kendo_combobox">
                                                    <input type="text" id="ColorID" name="ColorID" style="width: 100%;" tabindex="10" />
                                                    <span class="form-text text-muted ColorID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> *@
                                    
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Remarks</label>
                                                <div class="right-col">
                                                    <textarea id="Remarks" class="form-control" name="Remarks" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted Remarks">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @* <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Size</label>
                                                <div class="right-col kendo_combobox">
                                                    <input type="text" id="MarketingPersonID" name="MarketingPersonID" style="width: 100%;" tabindex="10" />
                                                    <span class="form-text text-muted MarketingPersonID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>  *@
                                    
                                    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8" id="divReviseNote">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Revise Reason</label>
                                                <div class="right-col">
                                                    <textarea id="ReviseReason" class="form-control" name="ReviseReason" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted ReviseReason">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8" id="divRejectNote">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Reject Reason</label>
                                                <div class="right-col">
                                                    <textarea id="RejectReason" class="form-control" name="RejectReason" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted RejectReason">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                    <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">File Upload</label>
                                                <div class="right-col">
                                                    <input type="file" class="form-control" placeholder="" id="BuyerRefFiles" name="BuyerRefFiles" multiple style="height: 37px !important;" />
                                                    <span class="form-text text-muted BuyerRefFiles">required.</span>
                                                    <canvas src="BuyerRefFiles" class="img-canvus-size" style="height:60px !important;" id="canvBuyerRefFiles"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div> 

                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-lg-3 text-lg-left">
                                        @* <div class="btn btn-sm btn-pdlprint btn-custom130" id="btnPrintIndent"><i class="fa fa-print"></i> Print Indent</div>  *@
                                    </div>
                                    <div class="col-lg-9 text-lg-right">
                                        <div class="btn btn-sm btn-pdlbacktolist btn-custom120" id="btnBackToList"> Back to List</div> 
                                        <div class="btn btn-sm btn-pdlsave btn-custom" id="btnSave"> <i class="fa fa-save"></i> Save</div> 
                                        <div class="btn btn-sm btn-pdlapproved btn-custom120" id="btnApproved"><i class="fa fa-check"></i>Approved</div>
                                        <div class="btn btn-sm btn-pdlrevise btn-custom btn-revcolor" id="btnRevise" style="display:none;"><i class="fa fa-reply-all"></i> Revise</div>
                                        <div class="btn btn-sm btn-pdlreject btn-custom" id="btnReject" style="display:none;"><i class="fa fa-ban"></i> Reject</div>
                                    </div> 
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section section_footer
{
    <script src="~/chem/Marketing/BuyerRef.js?version=@version"></script>

}

