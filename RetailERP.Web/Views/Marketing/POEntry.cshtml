@{
    var version = Guid.NewGuid().ToString();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section section_top
{
    <script type="text/javascript">
        localStorage.setItem("pageName", "@ViewBag.PageName");
        localStorage.setItem("menuId", "@ViewBag.MenuId");
    </script>

    <style>

        #tblPIInformation-71 {
            font-size: 12px;
        }

        #tblChild2PIInfo-1543, #tblChild3PIInfo-1543, #tblPIInfo-1543, #tblPIInfo_Audit-1891 {
            font-size: 12px;
        }

        .form-group label {
            font-size: 12px !important;
            font-weight: 400;
        }
    </style>

}

@{
    var pageId = ViewBag.PageName + "-" + ViewBag.MenuId;
    var divToolbarId = "divtoolbar" + pageId;
    var toolbarId = "toolbar" + pageId;
    var tblMasterId = "tbl" + pageId;
    var tblChildId = "tblChild" + pageId;
    var tblChildId2 = "tblChild2" + pageId;
    var tblChildId3 = "tblChild3" + pageId;
    var formId = "form" + pageId;
    var divDetailsId = "divDetails" + pageId;
}

<div class="d-flex flex-column-fluid" id="@pageId">
    <input type="hidden" id="ApprovePage" value="@ViewBag.ApprovePage" />

    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-custom gutter-b example example-compact" style="padding-top:10px; border-radius:0px !important;">
                    <div id="@divToolbarId">
                        <div class="row">
                            <div class="col-lg-12">
                                <div id="@toolbarId">
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px;display: none;" id="btnNewList">
                                        <i class="fa fa-plus"></i>&nbsp; New List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px; display: none;" id="btnEditList">
                                        <i class="fa fa-list"></i>&nbsp;Temp List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px; display: none;" id="btnPendingList">
                                        <i class="fa fa-list"></i>&nbsp;Pending List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px; display: none;" id="btnApprovedList">
                                        <i class="fa fa-list"></i>&nbsp;Approved List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary d-none" style="border-radius: 0px; display: none;" id="btnRejectList">
                                        <i class="fa fa-list"></i>&nbsp;Reject List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px; display: none;" id="btnAllList">
                                        <i class="fa fa-list"></i>&nbsp;All List
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div id="@tblMasterId"></div>
                            </div>
                        </div>
                    </div>

                    <form class="form" id="@formId">
                        <input type="hidden" id="POMasterID" name="POMasterID" value="0" />
                        <input type="hidden" id="OrderTypeID" name="OrderTypeID" value="0" />
                        <input type="hidden" id="BuyerRefMasterID_RPT" name="BuyerRefMasterID_RPT" value="0" />
                        <input type="hidden" id="BuyerRefColorID_RPT" name="BuyerRefColorID_RPT" value="0" />  
                        <input type="hidden" id="RowToken" name="RowToken" value="" />


                        <div class="card-body" id="@divDetailsId" style="display:none">
                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; General Information
                                </h6>
                            </div>

                            <div class="k-block p-4" style="border:1px solid #008093; border-radius:0px !important;">

                                <div class="row">
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Order Mode</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="OrderModeID" name="OrderModeID" style="width:100%;" />
                                                    <span class="form-text text-muted OrderModeID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3">
                                        <div class="form-group">
                                            <div class="form-inner6">
                                                <label class="left-col col-form-label text-lg-right">PO No</label>
                                                <div class="right-col kendo_combobox">
                                                    <input type="text" id="POMasterID_RPT" name="POMasterID_RPT" style="width: 100%;" tabindex="10" />
                                                    <span class="form-text text-muted POMasterID_RPT">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3">
                                        <div class="form-group">
                                            <div class="form-inner7">
                                                <label class="left-col col-form-label text-lg-right">Buyer Ref.</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="BuyerRef" name="BuyerRef" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted BuyerRef">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3">
                                        <div class="form-group">
                                            <div class="form-inner8">
                                                <label class="left-col col-form-label text-lg-right">Color Name</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="ColorName" name="ColorName" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted ColorName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <hr />

                                <div class="row">
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">PO No</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="PONo" name="PONo" style="font-weight:700 !important;" placeholder="" />
                                                    <span class="form-text text-muted PONo">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">PO Date</label>
                                                <div class="right-col">
                                                    <input type="text" class="w-100" kendorole="kendodatepicker" id="PODate" name="PODate" placeholder="dd-MMM-yyyy" autocomplete="off" />
                                                    <span class="form-text text-muted PODate">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Currency</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="CurrencyID" name="CurrencyID" style="width:100%;" />
                                                    <span class="form-text text-muted CurrencyID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Buyer Ref.</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="BuyerRefMasterID" name="BuyerRefMasterID" style="width:100%;" />
                                                    <span class="form-text text-muted BuyerRefMasterID">required.</span>
                                                </div> 
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Color Name</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="BuyerRefColorID" name="BuyerRefColorID" style="width:100%;" />
                                                    <span class="form-text text-muted BuyerRefColorID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Chemical Code</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" style="font-weight:700 !important;" placeholder="" id="ChemicalCode" name="ChemicalCode" disabled />
                                                    <span class="form-text text-muted ChemicalCode">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>  
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Payment Term </label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="PaymentTermsID" name="PaymentTermsID" style="width:100%;" />
                                                    <span class="form-text text-muted PaymentTermsID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Incoterm</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="IncotermID" name="IncotermID" style="width:100%;" />
                                                    <span class="form-text text-muted IncotermID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>                                    
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Marketing Person</label>
                                                <div class="right-col kendo_combobox">
                                                    <input type="text" id="POBy" name="POBy" style="width: 100%;" tabindex="10" />
                                                    <span class="form-text text-muted POBy">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Remarks</label>
                                                <div class="right-col">
                                                    <textarea id="Remarks" class="form-control" name="Remarks" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted Remarks">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8" id="divReviseNote">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Revise Reason</label>
                                                <div class="right-col">
                                                    <textarea id="ReviseReason" class="form-control" name="ReviseReason" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted ReviseReason">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8" id="divRejectNote">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Reject Reason</label>
                                                <div class="right-col">
                                                    <textarea id="RejectReason" class="form-control" name="RejectReason" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted RejectReason">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>  
                            </div>

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; Details Information
                                </h6>
                            </div>

                            <div class="row">
                                <div class="col-lg-12">
                                    <div id="@tblChildId"></div>
                                </div>
                            </div>

                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-lg-3 text-lg-left">
                                        @*  <div class="btn btn-sm btn-pdlprint btn-custom160" id="btnPrintPR"><i class="fa fa-print"></i> Print Requisition</div> *@
                                    </div>
                                    <div class="col-lg-9 text-lg-right">
                                        <div class="btn btn-sm btn-pdlbacktolist btn-custom120" id="btnBackToList"> Back to List</div>
                                        <div class="btn btn-sm btn-pdlsave btn-custom" id="btnSave"> <i class="fa fa-save" style="display:none;"></i> Save</div>
                                        <div class="btn btn-sm btn-pdlSaveForApprove btn-custom200" id="btnSaveForApprove" style="display:none;"><i class="fa fa-retweet"></i> Send for Approval</div>
                                        <div class="btn btn-sm btn-pdlapproved btn-custom150" id="btnApproved" style="display:none;"><i class="fa fa-check"></i>Save & Approved</div>
                                        <div class="btn btn-sm btn-pdlrevise btn-custom120 btn-revcolor d-none" id="btnRevise" style="display:none;"><i class="fa fa-reply-all"></i> Revise</div>
                                        <div class="btn btn-sm btn-pdlreject btn-custom120 d-none" id="btnReject" style="display:none;"><i class="fa fa-ban"></i> Reject</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section section_footer
{
    <script src="~/chem/Marketing/POEntry.js?version=@version"></script>

}

