@{
    var pageId = ViewBag.PageName + "-" + ViewBag.MenuId;
    var divToolbarId = "divtoolbar" + pageId;
    var toolbarId = "toolbar" + pageId;
    var tblMasterId = "tbl" + pageId;
    var tblConsumerId = "tblConsumer" + pageId;
    var tblIngredientId = "tblChild2" + pageId;
    var tblReferenceId = "tblChild3" + pageId;
    var tblProductTestId = "tblProductTest" + pageId;
    var tblPrimaryPackagingId = "tblPrimaryPackaging" + pageId;
    var tblSecondaryPackagingId = "tblSecondaryPackaging" + pageId;
    var tblShipperPackagingId = "tblShipperPackaging" + pageId;
    var formId = "form" + pageId;
    var divDetailsId = "divDetails" + pageId;
}

<div class="d-flex flex-column-fluid brief-template2" id="@pageId">
    <input type="hidden" id="ApprovePage" value="@ViewBag.ApprovePage" />

    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-custom gutter-b example example-compact" style="padding-top:10px; border-radius:0px !important;">
                    <div id="@divToolbarId" class="k-block">
                        <div class="row">
                            <div class="col-lg-12">
                                <div id="@toolbarId">
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px;" id="btnNewAdd">
                                        <i class="fa fa-plus"></i>&nbsp;New Add
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px;" id="btnEditList">
                                        <i class="fa fa-list"></i>&nbsp;Temp List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px;" id="btnApprovedList">
                                        <i class="fa fa-list"></i>&nbsp;Approved List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px;" id="btnRejectList">
                                        <i class="fa fa-list"></i>&nbsp;Reject List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px;" id="btnAllList">
                                        <i class="fa fa-list"></i>&nbsp;All List
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12 master-grid-host">
                                <div id="@tblMasterId"></div>
                            </div>
                        </div>
                    </div>

                    <form class="form" id="@formId">
                        <input type="hidden" id="BTMasterID" name="BTMasterID" value="0" />

                        <div class="card-body" id="@divDetailsId" style="display:none">
                            
                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; PROJECT INFORMATION
                                </h6>
                            </div> 
                            <div class="k-block" style="border:1px solid #008093; border-radius:0px !important;">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Project Name</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" id="ProjectName" name="ProjectName" />
                                                    <span class="form-text text-muted ProjectName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Brand</label>
                                                <div class="right-col">
                                                    <input type="text" id="BrandID" name="BrandID" style="width:100%;" />
                                                    <span class="form-text text-muted BrandID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Project Leader</label>
                                                <div class="right-col">
                                                    <input type="text" id="ProjectLeaderBy" name="ProjectLeaderBy" style="width:100%;" />
                                                    <span class="form-text text-muted ProjectLeaderBy">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Completion Date</label>
                                                <div class="right-col">
                                                    <input type="text" class="w-100" id="CompletionDate" name="CompletionDate" placeholder="dd-MMM-yyyy" autocomplete="off" />
                                                    <span class="form-text text-muted CompletionDate">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Market Compliance</label>
                                                <div class="right-col multi_select multi_select_multicolumn">
                                                    <input id="CountryIDs" name="CountryIDs" style="width:100%;" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div> 

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; FORECAST & COGs
                                </h6>
                            </div> 
                            <div class="k-block" style="border:1px solid #008093; border-radius:0px !important;">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Product</label>
                                                <div class="right-col">
                                                    <input type="text" id="ProductID" name="ProductID" style="width:100%;" />
                                                    <span class="form-text text-muted ProductID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Order Volume</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-center" id="OrderQuantity" name="OrderQuantity" />
                                                    <span class="form-text text-muted OrderQuantity">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Target Cost</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-center" id="TargetPerQtyCost" name="TargetPerQtyCost" />
                                                    <span class="form-text text-muted TargetPerQtyCost">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Service Option</label>
                                                <div class="right-col">
                                                    <input type="text" id="ServiceOptionID" name="ServiceOptionID" style="width:100%;" />
                                                    <span class="form-text text-muted ServiceOptionID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Max. Bulk Price</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-center" id="MaxBulkPrice" name="MaxBulkPrice" />
                                                    <span class="form-text text-muted MaxBulkPrice">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; PRODUCT INFORMATION
                                </h6>
                            </div>  
                            <div class="k-block" style="border:1px solid #008093; border-radius:0px !important;">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Product Type</label>
                                                <div class="right-col">
                                                    <input type="text" id="ProductTypeID" name="ProductTypeID" style="width:100%;" />
                                                    <span class="form-text text-muted ProductTypeID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Texture</label>
                                                <div class="right-col">
                                                    <input type="text" id="TextureID" name="TextureID" style="width:100%;" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Color</label>
                                                <div class="right-col">
                                                    <input type="text" id="ColorID" name="ColorID" style="width:100%;" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Fragrance</label>
                                                <div class="right-col">
                                                    <input type="text" id="FragranceID" name="FragranceID" style="width:100%;" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Certification</label>
                                                <div class="right-col">
                                                    <input type="text" id="Certification" name="Certification" class="form-control" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                   
                                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Product Performance</label>
                                                <div class="right-col">
                                                    <textarea id="ProductPerformance" name="ProductPerformance" class="form-control" rows="2"></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Product Claims</label>
                                                <div class="right-col">
                                                    <textarea id="ProductClaims" name="ProductClaims" class="form-control" rows="2"></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                                        <div class="form-group">
                                            <div class="form-inner12">
                                                <label class="left-col col-form-label text-lg-right">Additional Comments</label>
                                                <div class="right-col">
                                                    <textarea id="AdditionalComments" name="AdditionalComments" class="form-control" rows="2"></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; CONSUMER / TARGET AUDIENCE
                                </h6>
                            </div> 
                            @* <div class="k-block mb-1" style="padding:5px !important; border-radius:0px !important; margin-top:10px;">
                                <h6 class="card-title section-title">
                                    <i class="fa fa-cogs text-info text-primary"></i> &nbsp; CONSUMER / TARGET AUDIENCE
                                </h6>
                            </div> *@
                            <div class="grid-host" id="@tblConsumerId"></div>

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; INGREDIENT REQUIREMENTS
                                </h6>
                            </div> 
                            <div class="grid-host" id="@tblIngredientId"></div>

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; REFERENCE PRODUCTS
                                </h6>
                            </div> 
                            <div class="grid-host" id="@tblReferenceId"></div>

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; PRIMARY PACKAGING
                                </h6>
                            </div> 
                            <div class="grid-host" id="@tblPrimaryPackagingId"></div>

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; SECONDARY PACKAGING
                                </h6>
                            </div> 
                            <div class="grid-host" id="@tblSecondaryPackagingId"></div>

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; SHIPPER PACKAGING
                                </h6>
                            </div> 
                            <div class="grid-host" id="@tblShipperPackagingId"></div>

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; PRODUCT TESTS
                                </h6>
                            </div> 
                            <div class="grid-host" id="@tblProductTestId"></div>

                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-lg-3 text-lg-left"></div>
                                    <div class="col-lg-9 text-lg-right">
                                        <div class="btn btn-sm btn-pdlbacktolist btn-custom120" id="btnBackToList"> Back to List</div>
                                        <div class="btn btn-sm btn-pdlsave btn-custom" id="btnSave"><i class="fa fa-save"></i> Save</div>
                                        <div class="btn btn-sm btn-pdlSaveForApprove btn-custom170" id="btnSaveForApprove"><i class="fa fa-retweet"></i> Save & Approved</div> 
                                        <div class="btn btn-sm btn-pdlreject btn-custom120" id="btnReject" style="display:none;"><i class="fa fa-ban"></i> Reject</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section section_footer
{
    <script src="~/chem/Marketing/BriefTemplate.js?version=@version"></script>
}
