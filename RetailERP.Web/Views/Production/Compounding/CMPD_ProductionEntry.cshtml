@{
    var version = Guid.NewGuid().ToString();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section section_top
{
    <script type="text/javascript">
        localStorage.setItem("pageName", "@ViewBag.PageName");
        localStorage.setItem("menuId", "@ViewBag.MenuId");
    </script>

    <style>

        #tblPIInformation-71 {
            font-size: 12px;
        }

        #tblChild2PIInfo-1543, #tblChild3PIInfo-1543, #tblPIInfo-1543, #tblPIInfo_Audit-1891 {
            font-size: 12px;
        }

        .form-group label {
            font-size: 12px !important;
            font-weight: 400;
        }
    </style>

}

@{
    var pageId = ViewBag.PageName + "-" + ViewBag.MenuId;
    var divToolbarId = "divtoolbar" + pageId;
    var toolbarId = "toolbar" + pageId;
    var tblMasterId = "tbl" + pageId;
    var tblChildId = "tblChild" + pageId;
    var tblChildId2 = "tblChild2" + pageId;
    var tblChildId3 = "tblChild3" + pageId;
    var formId = "form" + pageId;
    var divDetailsId = "divDetails" + pageId;
}

<div class="d-flex flex-column-fluid" id="@pageId">
    <input type="hidden" id="ApprovePage" value="@ViewBag.ApprovePage" /> 

    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-custom gutter-b example example-compact" style="padding-top:10px; border-radius:0px !important;">
                    <div id="@divToolbarId">
                        <div class="row">
                            <div class="col-lg-12">
                                <div id="@toolbarId">
                                    <div class="btn btn-sm fw-bold btn-primary" style="border-radius: 0px; " id="btnPendingList">
                                        <i class="fa fa-list"></i>&nbsp;Pending List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-primary" style="border-radius: 0px; display: none;" id="btnEditList">
                                        <i class="fa fa-list"></i>&nbsp;Temp List
                                    </div> 
                                    <div class="btn btn-sm fw-bold btn-primary" style="border-radius: 0px; display: none;" id="btnApprovedList">
                                        <i class="fa fa-list"></i>&nbsp; Approved List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-primary d-none" style="border-radius: 0px; display: none;" id="btnRejectList">
                                        <i class="fa fa-list"></i>&nbsp;Reject List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-primary" style="border-radius: 0px; display: none;" id="btnAllList">
                                        <i class="fa fa-list"></i>&nbsp;All List
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div id="@tblMasterId"></div>
                            </div>
                        </div>
                    </div>

                    <form class="form" id="@formId">
                        <input type="hidden" id="ProductionMasterID" name="ProductionMasterID" value="0" />
                        <input type="hidden" id="POMasterID" name="POMasterID" value="0" />
                        <input type="hidden" id="POChildID" name="POChildID" value="0" />
                        @*<input type="hidden" id="SubSectionID" name="SubSectionID" value="0" />  *@

                        <div class="card-body" id="@divDetailsId" style="display:none">
                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; General Information
                                </h6>
                            </div>

                            <div class="k-block p-4" style="border:1px solid #008093; border-radius:0px !important;">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">PO No</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="PONo" name="PONo" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted PONo">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Product Name</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="FinishedProductName" name="FinishedProductName" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted FinishedProductName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">PO Qty</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="POQty" name="POQty" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted POQty">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Chemical Code</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="ChemicalCode" name="ChemicalCode" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted ChemicalCode">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Product Description</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="FinishedProductDescription" name="FinishedProductDescription" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted FinishedProductDescription">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Size Gram</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="SizeGram" name="SizeGram" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted SizeGram">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Brand Ref.</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="BuyerRef" name="BuyerRef" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted BuyerRef">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Color Name</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="ColorName" name="ColorName" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted ColorName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">UOM</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="UOM" name="UOM" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted UOM">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Brand Name</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="BuyerName" name="BuyerName" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted BuyerName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Packaging Type</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="PackagingName" name="PackagingName" style="font-weight:700 !important;" placeholder="" disabled />
                                                    <span class="form-text text-muted PackagingName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                </div>

                                <hr /> 
                                  
                                <div class="row"> 
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Lot No</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="LotNo" name="LotNo" style="font-weight:700 !important;" placeholder=""  />
                                                    <span class="form-text text-muted LotNo">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Batch No</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="BatchNo" name="BatchNo" style="font-weight:700 !important;" placeholder="" />
                                                    <span class="form-text text-muted BatchNo">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Production Date</label>
                                                <div class="right-col">
                                                    <input type="text" class="w-100" kendorole="kendodatepicker" id="ProductionDate" name="ProductionDate" placeholder="dd-MMM-yyyy" autocomplete="off" />
                                                    <span class="form-text text-muted ProductionDate">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Entry Person</label>
                                                <div class="right-col kendo_combobox">
                                                    <input type="text" id="ProductionBy" name="ProductionBy" style="width: 100%;" tabindex="10" />
                                                    <span class="form-text text-muted ProductionBy">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Shift</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="ShiftID" name="ShiftID" style="width:100%;" />
                                                    <span class="form-text text-muted ShiftID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Production Qty</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-left" id="ProductionQty" name="ProductionQty" style="font-weight:700 !important;" placeholder="" />
                                                    <span class="form-text text-muted ProductionQty">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Remarks</label>
                                                <div class="right-col">
                                                    <textarea id="Remarks" class="form-control" name="Remarks" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted Remarks">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>  
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4" id="divReviseNote">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Revise Reason</label>
                                                <div class="right-col">
                                                    <textarea id="ReviseReason" class="form-control" name="ReviseReason" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted ReviseReason">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4" id="divRejectNote">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Reject Reason</label>
                                                <div class="right-col">
                                                    <textarea id="RejectReason" class="form-control" name="RejectReason" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted RejectReason">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; Chemical Consumption Information
                                </h6>
                            </div> 
                            
                            <div class="row">
                                <div class="col-lg-12">
                                    <div id="@tblChildId"></div>
                                </div>
                            </div>

                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-lg-3 text-lg-left">
                                        @* <div class="btn btn-sm btn-pdlprint btn-custom160" id="btnPrintPR"><i class="fa fa-print"></i> Print Requisition</div>  *@
                                    </div>
                                    <div class="col-lg-9 text-lg-right">
                                        <div class="btn btn-sm btn-pdlbacktolist btn-custom120" id="btnBackToList"> Back to List</div> 
                                        <div class="btn btn-sm btn-pdlsave btn-custom" id="btnSave"> <i class="fa fa-save"></i> Save</div>
                                        <div class="btn btn-sm btn-pdlapproved btn-custom160" id="btnApproved"><i class="fa fa-check"></i> Save & Approved</div>
                                        <div class="btn btn-sm btn-pdlrevise btn-custom120 btn-revcolor d-none" id="btnRevise" style="display:none;"><i class="fa fa-reply-all"></i> Revise</div>
                                        <div class="btn btn-sm btn-pdlreject btn-custom120 d-none" id="btnReject" style="display:none;"><i class="fa fa-ban"></i> Reject</div>
                                    </div> 
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section section_footer
{
    <script src="~/chem/production/compounding/cmpd_productionentry.js?version=@version"></script> 
}

