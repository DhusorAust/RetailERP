    <script>
        $.ajaxSetup({
            async: false
        });
        var isExportPage = false;
        var MenuTitle2 = '@ViewBag.MenuTitle2';
        var MenuTitle3 = '@ViewBag.MenuTitle3';
        var MenuTitle4 = '@ViewBag.MenuTitle4';

        var base = '@Url.Content("~/")';
        $(document).on('focus', '.select2.select2-container', function (e) {
            // only open on original attempt - close focus event should not fire open
            if (e.originalEvent && $(this).find(".select2-selection--single").length > 0) {
                $(this).siblings('select').select2('open');
            }
        });

        var CurrentUser = "";
        var gbGridHeight="700px";

        $(document).ready(function () {
            $('.kt_datepicker_1,.kt_datepicker_3').on('changeDate', function (ev) {
                $(this).datepicker('hide');
            });

            $('.tools').hide();
            $('.tools').css({ "display": "none" });


        //Tab Index
        let enterHandled = false;
        $(document).on("keypress", "[tabindex]", function (e) {
            if (e.which === 13 && !enterHandled) {
                enterHandled = true; // prevent re-trigger

                e.preventDefault();

                const $current = $(this);
                const currentTabIndex = parseInt($current.attr("tabindex"));

                const $all = $("[tabindex]")
                    .filter(":visible:not(:disabled)")
                    .sort((a, b) => parseInt($(a).attr("tabindex")) - parseInt($(b).attr("tabindex")));

                let found = false;

                $all.each(function () {
                    const ti = parseInt($(this).attr("tabindex"));
                    if (ti > currentTabIndex && !found) {
                        $(this).focus();
                        found = true;
                    }
                });

                // Optional: If nothing left, call custom focus (like grid)
                if (!found && isExportPage) {
                    GridHelper.FocusKendoChildField(TblChildId, "objCount_ComExList");
                }

                // Reset after short delay
                setTimeout(() => {
                    enterHandled = false;
                }, 100);
            }
        });

            //Load Menu
            var menuData = @Html.Raw(JsonConvert.SerializeObject(Model.MenuList));
            MenuHelper.InitMenu(menuData);

            //Load SessionUser into Global
            GetCurrentUser();


           // LoadRamadanHadish();

            //for mark test database
            if (CurrentUser.DabaseName != "ERPDB") {
                $("#divDbName").show();
                $("#lblDbName").html("TEST DB :  " + CurrentUser.DabaseName);
                $("#kt_quick_user_toggle").html(CurrentUser.DabaseName);
                //$('#kt_quick_user_toggle').css('color', 'white');
                //$('#kt_header').attr('style', 'background-color: #F7032C !important');
            }
            else {
                $("#divDbName").hide();
                $("#lblDbName").html("");
            }

            UpdateDashboard();

            //user photo display
            if (CurrentUser.Image64 != "" && CurrentUser.Image64 != null && CurrentUser.Image64 != undefined) {
                document.getElementById("profilePic").src = "data:image/png;base64," + CurrentUser.Image64;
                localStorage.setItem('profilePic', CurrentUser.Image64);

                $("#divAvatar").attr("src", "data:image/png;base64," + CurrentUser.Image64);
            } else {
                $("#profilePic").attr("src", "/files/usr1.jpg");
                $("#divAvatar").attr("src", "/files/usr1.jpg");
                localStorage.setItem('profilePic', null);
            }
            //set coockies

            $('.imgCompanyLogo').attr('src', '/Files/logo.png')
                .css({
                    height: '65px',
                    width: '160px',
                }).css({ 'border-radius': '5px', 'opacity': '0.9' });


          if ([4].includes(CurrentUser.UnitID)) {
                $('.imgCompanyLogo').attr('src', '/Files/logo.png')
                    .css({
                        height: '56px',
                        width: '160px',

                    }).css({ 'border-radius': '5px','opacity': '0.9' });
            }
            else if ([7].includes(CurrentUser.UnitID)) {
                $('.imgCompanyLogo').attr('src', '/Files/logo.png')
                    .css({
                        height: '56px',
                        width: '160px',
                    }).css({ 'border-radius': '5px', 'opacity': '0.9' });
            }


            // Set Menu Breadcum Design

            $(".bcMenuTitle2").removeClass('breadcumDesign');
            $(".bcMenuTitle3").removeClass('breadcumDesign');
            $(".bcMenuTitle4").removeClass('breadcumDesign');

            //Show Class
            if (MenuTitle4 != "") {
                $(".bcMenuTitle4").addClass('breadcumDesign');

                $(".bcMenuTitle2").addClass('breadcumColor');
                $(".bcMenuTitle3").addClass('breadcumColor');
            }
            else if (MenuTitle3 != "") {
                $(".bcMenuTitle3").addClass('breadcumDesign');

                $(".bcMenuTitle2").addClass('breadcumColor');
            }
            else if (MenuTitle2 != "") {
                $(".bcMenuTitle2").addClass('breadcumDesign');
            }


           gbGridHeight = $(window).height() - 120;

        });
        function UpdateDashboard() {
            var currentTime = DateTimeHelper.GetValidTime();
            var currentDate = kendo.toString(new Date(), "dddd, MMM dd, yyyy");
            if (CurrentUser.UserID == "1") {
                // $("#divIpName").show();
                if (CurrentUser.DabaseName == "PDL_Sample") {
                    $("#lblIpAddress").html("TEST SAMPLE PRODUCTION");
                }
            }
            else {
                //$("#divIpName").hide();
            }

            $("#lblIpAddress").html(currentDate + ", " + currentTime.toString());
            setTimeout('UpdateDashboard()', 100);
        }
        function GetCurrentUser() {
            var objUser = "";
            var jsonParam = "";
            var serviceUrl = `../Security/GetCurrentUser`;
            AjaxManager.GetList(serviceUrl, onSuccess, onFailed);
            function onSuccess(jsonData) {
                objUser = jsonData;
                CurrentUser = jsonData;
            }
            function onFailed(error) {
                window.alert(error.statusText);
            }
            return objUser;
        }
        function LoadRamadanHadish() {
            $.ajax({
                type: "POST",
                url: base + "Security/GetRamadanHadis",
                //data: { UserName: $("#UserID").val(), PasswordH: $("#PasswordH").val() },
                dataType: "json",
                success: function (data) {
                    if (data.length > 0) {
                        $("#idHadish").html(data[0].NoticePart1);
                        $("#idHadish2").html(data[0].NoticePart2);
                    }
                },
                error: function (req, status, error) {
                    MessageHelper.Warning(error, "Warning");
                }
            });
        }

        // Stop Menu open ON Hover
                  document.addEventListener("DOMContentLoaded", function () {
          const body = document.body;
          const btn = document.getElementById("kt_aside_toggle2");
          // hover ????? ????? ????? ??? ??
          new MutationObserver(() => {
            if (body.classList.contains("aside-minimize-hover")) {
              body.classList.remove("aside-minimize-hover");
            }
          }).observe(body, { attributes: true, attributeFilter: ["class"] });

          btn?.addEventListener("click", function (e) {
            e.preventDefault();
            body.classList.toggle("aside-minimize");
            body.classList.remove("aside-minimize-hover");
          });
        });




    </script>

