@{
    var version = Guid.NewGuid().ToString();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section section_top
    {
    <script type="text/javascript">
        localStorage.setItem("pageName", "@ViewBag.PageName");
        localStorage.setItem("menuId", "@ViewBag.MenuId");
    </script>

    <style>

/*        #tblPIInformation-71 {
            font-size: 12px;
        }*/

/*        #tblChild2PIInfo-1543, #tblChild3PIInfo-1543, #tblPIInfo-1543, #tblPIInfo_Audit-1891 {
            font-size: 12px;
        }*/

        .form-group label {
            font-size: 12px !important;
            font-weight: 400;
        }

        #tblChildReceive-192, #tblReceive-192 {
            font-size: 12px;
        }

        .clsPOPAdd {
            background-color: #164a8a !important;
            border-color: #17273b !important;
            color: #fff;
            display: inline-block;
            font-weight: 400;
            text-align: center;
            vertical-align: middle;
            border: 1px solid transparent;
            padding: 6px 10px 6px 10px;
            font-size: 1rem;
            line-height: 1.5;
            border-radius: 0px;
            float: left;
            cursor: pointer;
        }
    </style>

}

@{
    var pageId = ViewBag.PageName + "-" + ViewBag.MenuId;
    var divToolbarId = "divtoolbar" + pageId;
    var toolbarId = "toolbar" + pageId;
    var tblMasterId = "tbl" + pageId;
    var tblChildId = "tblChild" + pageId;
    var tblChildId2 = "tblChild2" + pageId;
    var tblChildId3 = "tblChild3" + pageId;
    var formId = "form" + pageId;
    var divDetailsId = "divDetails" + pageId;
}

<div class="d-flex flex-column-fluid" id="@pageId">
    <input type="hidden" id="QCPage" value="@ViewBag.QCPage" />
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-custom gutter-b example example-compact" style="padding-top:10px; border-radius:0px !important;">
                    <div id="@divToolbarId">
                        <div class="row">
                            <div class="col-lg-12">
                                <div id="@toolbarId">
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px; display: none;" id="btnAddNew">
                                        <i class="fa fa-plus"></i>&nbsp;New Add
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px; display: none;" id="btnEditList">
                                        <i class="fa fa-list"></i>&nbsp;Temp List
                                    </div>

                                    <div class="btn btn-sm fw-bold btn-secondary toolbar-dom" id="btnQCPendingList" style="border-radius: 0px; display: none;">
                                        <i class="fa fa-list"></i>&nbsp;QC Pending List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary toolbar-dom" id="btnQCPassedList" style="border-radius: 0px; display: none;">
                                        <i class="fa fa-list"></i>&nbsp;QC Passed List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary toolbar-dom" id="btnQCFailedList" style="border-radius: 0px; display: none;">
                                        <i class="fa fa-list"></i>&nbsp;QC Failed List
                                    </div>

                                    <div class="btn btn-sm fw-bold btn-primary" id="btnMrrPendingList" style="border-radius: 0px; display: none;">
                                        <i class="fa fa-list"></i>&nbsp; Pending MRR
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-primary" id="btnMrrList" style="border-radius: 0px; display: none;">
                                        <i class="fa fa-list"></i>&nbsp; MRR List
                                    </div>





                                    <div class="btn btn-sm fw-bold btn-primary" id="btnPendingList" style="border-radius: 0px; display: none;">
                                        <i class="fa fa-list"></i>&nbsp; Pending List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" id="btnPendingApproveList" style="border-radius: 0px; display: none;">
                                        <i class="fa fa-list"></i>&nbsp;Pending For Approve List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" id="btnApprovedList" style="border-radius: 0px; display: none;">
                                        <i class="fa fa-list"></i>&nbsp;Approved List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" id="btnRejectList" style="border-radius: 0px; display: none;">
                                        <i class="fa fa-list"></i>&nbsp;Reject List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary" id="btnAllList" style="border-radius: 0px; display: none;">
                                        <i class="fa fa-list"></i>&nbsp;All List
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div id="@tblMasterId"></div>
                            </div>
                        </div>
                    </div>

                    <form class="form" id="@formId">

                        <input type="hidden" id="ReceiveMasterID" name="ReceiveMasterID" value="0" />
                        <input type="hidden" id="IndentMasterID" name="IndentMasterID" value="0" />
                        <input type="hidden" id="PRMasterID" name="PRMasterID" value="0" />
                        <input type="hidden" id="SSReturnMasterID" name="SSReturnMasterID" value="0" />


                        <div class="card-body" id="@divDetailsId" style="display:none">
                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; General Information
                                </h6>
                            </div>

                            <div class="k-block p-4" style="border:1px solid #008093; border-radius:0px !important;">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Project</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="UnitID" name="UnitID" style="width:100%; " />
                                                    <span class="form-text text-muted UnitID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Store</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="StoreID" name="StoreID" style="width:100%; " />
                                                    <span class="form-text text-muted StoreID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Receive No</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-center" style="font-weight:700 !important;" placeholder="" id="ReceiveNo" name="ReceiveNo" disabled />
                                                    <span class="form-text text-muted ReceiveNo">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Receive Date</label>
                                                <div class="right-col">
                                                    <input type="text" class="w-100" kendorole="kendodatepicker" placeholder="dd-MMM-yyyy" id="ReceiveDate" name="ReceiveDate" autocomplete="off" />
                                                    <span class="form-text text-muted ReceiveDate">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Receive Type</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="ReceiveTypeID" name="ReceiveTypeID" style="width:100%; " />
                                                    <span class="form-text text-muted ReceiveTypeID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Receive by</label>
                                                <div class="right-col kendo_combobox">
                                                    <input type="text" id="ReceiveBy" name="ReceiveBy" style="width: 100%;" tabindex="10" />
                                                    <span class="form-text text-muted ReceiveBy">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Checked by</label>
                                                <div class="right-col kendo_combobox">
                                                    <input type="text" id="CheckedBy" name="CheckedBy" style="width: 100%;" tabindex="10" />
                                                    <span class="form-text text-muted CheckedBy">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Supplier</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="SupplierID" name="SupplierID" style="width:100%; " />
                                                    <span class="form-text text-muted SupplierID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Challan No</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-center" style="font-weight:700 !important;" placeholder="" id="ChallanNo" name="ChallanNo" />
                                                    <span class="form-text text-muted ChallanNo">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Challan Date</label>
                                                <div class="right-col">
                                                    <input type="text" class="w-100" kendorole="kendodatepicker" placeholder="dd-MMM-yyyy" id="ChallanDate" name="ChallanDate" autocomplete="off" />
                                                    <span class="form-text text-muted ChallanDate">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Gate Pass No</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control text-center" style="font-weight:700 !important;" placeholder="" id="GatePassNo" name="GatePassNo" />
                                                    <span class="form-text text-muted GatePassNo">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Gate Pass Date</label>
                                                <div class="right-col">
                                                    <input type="text" class="w-100" kendorole="kendodatepicker" placeholder="dd-MMM-yyyy" id="GatePassDate" name="GatePassDate" autocomplete="off" />
                                                    <span class="form-text text-muted GatePassDate">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Remarks</label>
                                                <div class="right-col">
                                                    <textarea id="Remarks" class="form-control" name="Remarks" rows="1" cols="20" autocomplete="off"></textarea>
                                                    <span class="form-text text-muted Remarks">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" id="divReviseNote">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Revise Reason</label>
                                                <div class="right-col">
                                                    <textarea id="ReviseReason" class="form-control" name="ReviseReason" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted ReviseReason">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" id="divRejectNote">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Reject Reason</label>
                                                <div class="right-col">
                                                    <textarea id="RejectReason" class="form-control" name="RejectReason" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted RejectReason">.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4" id="divIndentNo">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Indent No</label>
                                                <div class="right-col" style="width: calc(91% - 188px); float: left; margin-right: 7px;">
                                                    <input type="text" id="cboIndentNo" name="cboIndentNo" style="width:100%; height:32px;" />
                                                </div>
                                                <div id="btnAddToList" class="clsPOPAdd">Add To List</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important; margin-top:2px;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; Details Information
                                </h6>
                            </div>

                            <div class="row">
                                <div class="col-lg-12">
                                    <div id="@tblChildId"></div>
                                </div>
                            </div>

                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-lg-3 text-lg-left">
                                        <div class="btn btn-sm btn-pdlprint btn-custom130" id="btnPrintIndent" style="display:none;"><i class="fa fa-print"></i> Print Indent</div>
                                    </div>
                                    <div class="col-lg-9 text-lg-right">
                                        <div class="btn btn-sm btn-pdlbacktolist btn-custom120" id="btnBackToList"> Back to List</div>
                                        <div class="btn btn-sm btn-pdlsave btn-custom" id="btnSave"> <i class="fa fa-save" style="display:none;"></i> Save</div>
                                        <div class="btn btn-sm btn-pdlSaveForApprove btn-custom230" id="btnSaveNSentToQC" style="display:none;"><i class="fa fa-retweet"></i> Save & Send To QC</div>
                                        <div class="btn btn-sm btn-pdlsave btn-custom230" id="btnSaveQC" style="display:none;"><i class="fa fa-retweet"></i> Save QC</div>
                                        <div class="btn btn-sm btn-pdlSaveForApprove btn-custom230" id="btnSentToMRR" style="display:none;"><i class="fa fa-retweet"></i> Save & Send To MRR</div>
                                        <div class="btn btn-sm btn-pdlsave btn-custom230" id="btnSaveMRR" style="display:none;"><i class="fa fa-retweet"></i> MRR Generate</div>


                                        <div class="btn btn-sm btn-pdlSaveForApprove btn-custom230" id="btnSaveForApprove" style="display:none;"><i class="fa fa-retweet"></i> Save & Send To Approve</div>
                                        <div class="btn btn-sm btn-pdlapproved btn-custom120" id="btnApproved" style="display:none;"><i class="fa fa-check"></i>Approved</div>
                                        <div class="btn btn-sm btn-pdlrevise btn-custom btn-revcolor" id="btnRevise" style="display:none;"><i class="fa fa-reply-all"></i> Revise</div>
                                        <div class="btn btn-sm btn-pdlreject btn-custom" id="btnReject" style="display:none;"><i class="fa fa-ban"></i> Reject</div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section section_footer
    {
    <script src="~/chem/ChemicalStore/Receive.js?version=@version"></script>

}


