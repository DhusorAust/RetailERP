    <style type="text/css">
        .ticker {
            width: 100% !important;
        }
        .clock {
            color: #093956;
            font-size: 25px;
            font-family: orbitron-variablefont_wght;
            letter-spacing: 3px;
            font-weight: bold
        }
    </style> 
     
    <link href="~/common/dashboard/dashboardmain.css" rel="stylesheet" />
    <link href="~/common/newsticker/ticker-style.css" rel="stylesheet" />

