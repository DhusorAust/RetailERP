        #chartMostSellFabCodediv, #chartComExPILCInvStatus, #chartTodaysInspectionStatus, #chartTopTenBuyers, #chartTopTenBrands, #chartComMktTeamStatus, #chartComMktTeamStatus2 {
            width: 100%;
            height: 380px;
        } 
    </style>
} 
