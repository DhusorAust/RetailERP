@{
    var version = Guid.NewGuid().ToString();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section section_top
    {
    <script type="text/javascript">
        localStorage.setItem("pageName", "@ViewBag.PageName");
        localStorage.setItem("menuId", "@ViewBag.MenuId");
    </script>
}
@{
    var pageId = ViewBag.PageName + "-" + ViewBag.MenuId;
    var divToolbarId = "divtoolbar" + pageId;
    var toolbarId = "toolbar" + pageId;
    var tblMasterId = "tbl" + pageId;
    var tblChildId = "tblChild" + pageId;
    var formId = "form" + pageId;
    var divDetailsId = "divDetails" + pageId;
}

<div class="d-flex flex-column-fluid" id="@pageId">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-custom gutter-b example example-compact" style="padding-top:10px;">
                    <form class="form" id="@formId">
                        <input type="hidden" id="UserID" name="UserID" value="-1111" />

                        <div class="card-body" id="@divDetailsId">
                            <div class="card-header" style="padding:0px;">
                                <h6 class="card-title" style="margin-bottom:5px;"> Change Password</h6>
                            </div>

                            <div class="row" style="padding-bottom:10px;">
                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner13">
                                            <label class="left-col col-form-label text-lg-right">Current Password</label>
                                            <div class="right-col">
                                                <input type="password" class="form-control" placeholder="" id="OldPassword" name="OldPassword" />
                                                <span class="form-text text-muted OldPassword">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner13">
                                            <label class="left-col col-form-label text-lg-right">New Password</label>
                                            <div class="right-col">
                                                <input type="password" class="form-control" placeholder="" id="NewPassword" name="NewPassword" />
                                                <span class="form-text text-muted NewPassword">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner13">
                                            <label class="left-col col-form-label text-lg-right">Confirm Password</label>
                                            <div class="right-col">
                                                <input type="password" class="form-control" placeholder="" id="ConfirmPassword" name="ConfirmPassword" />
                                                <span class="form-text text-muted ConfirmPassword">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-lg-6"> </div>
                                    <div class="col-lg-6 text-lg-right">
                                        <div class="btn btn-secondary btn-custom" id="btnClear">Clear</div>
                                        <div class="btn btn-primary btn-custom150" id="btnChangePassword">Change Password</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section section_footer
    {
    <script src="~/BTL/Security/ChangePassword.js?version=@version"></script>
}

