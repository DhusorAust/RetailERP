@{
    var version = Guid.NewGuid().ToString();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section section_top
{
<script type="text/javascript">
    localStorage.setItem("pageName", "@ViewBag.PageName");
    localStorage.setItem("menuId", "@ViewBag.MenuId");
</script>
}
@{
    var pageId = ViewBag.PageName + "-" + ViewBag.MenuId;
    var divToolbarId = "divtoolbar" + pageId;
    var toolbarId = "toolbar" + pageId;
    var tblMasterId = "tbl" + pageId;
    var tblChildId = "tblChild" + pageId;
    var formId = "form" + pageId;
    var divDetailsId = "divDetails" + pageId;
}

<div class="d-flex flex-column-fluid" id="@pageId">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-custom gutter-b example example-compact" style="padding-top:10px;">
                    <div id="@divToolbarId">
                        <div class="row">
                            <div class="col-lg-12">
                                <div id="@toolbarId">
                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px;" id="btnNewAdd">
                                        <i class="fa fa-plus"></i>&nbsp;New Add
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-primary" style="border-radius: 0px;" id="btnEditList">
                                        <i class="fa fa-list"></i>&nbsp;Save List
                                    </div>  
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div id="@tblMasterId"></div>
                            </div>
                        </div>
                    </div>

                    <form class="form" id="@formId">
                        <input type="hidden" id="UserID" name="UserID" value="-1111" />
                        <input type="hidden" id="IsActive" name="IsActive" value="1" />

                        <div class="card-body" id="@divDetailsId" style="display:none">
                            <div class="card-header" style="padding:0px;">
                                <h6 class="card-title" style="margin-bottom:5px;"> General Information</h6>
                            </div>

                            <div class="row" style="padding-bottom:10px;">
                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner10">
                                            <label class="left-col col-form-label text-lg-right">User Role</label>
                                            <div class="right-col">
                                                <select class="form-control kt_select2_1" id="UserRoleID" name="UserRoleID">
                                                    <option value="-1">Select</option>
                                                </select>
                                                <span class="form-text text-muted UserRoleID">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner10">
                                            <label class="left-col col-form-label text-lg-right">User Name</label>
                                            <div class="right-col">
                                                <input type="text" class="form-control" placeholder="" id="UserName" name="UserName" />
                                                <span class="form-text text-muted UserName">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner10">
                                            <label class="left-col col-form-label text-lg-right">Employee</label>
                                            <div class="right-col">
                                                <select class="form-control kt_select2_1" id="EmployeeID" name="EmployeeID">
                                                    <option value="-1">Select</option>
                                                </select>
                                                <span class="form-text text-muted EmployeeID">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner10">
                                            <label class="left-col col-form-label text-lg-right">Department</label>
                                            <div class="right-col">
                                                <input type="text" class="form-control" placeholder="" id="DepartmentName" name="DepartmentName" disabled="disabled" />
                                                <span class="form-text text-muted DepartmentName">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner10">
                                            <label class="left-col col-form-label text-lg-right">Designation</label>
                                            <div class="right-col">
                                                <input type="text" class="form-control" placeholder="" id="DesignationName" name="DesignationName" disabled="disabled" />
                                                <span class="form-text text-muted DepartmentName">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner10">
                                            <label class="left-col col-form-label text-lg-right">Section</label>
                                            <div class="right-col">
                                                <input type="text" class="form-control" placeholder="" id="SectionName" name="SectionName" disabled="disabled" />
                                                <span class="form-text text-muted SectionName">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner10">
                                            <label class="left-col col-form-label text-lg-right">Sub Section</label>
                                            <div class="right-col">
                                                <input type="text" class="form-control" placeholder="" id="SubSectionName" name="SubSectionName" disabled="disabled" />
                                                <span class="form-text text-muted SubSectionName">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner10">
                                            <label class="left-col col-form-label text-lg-right">Status</label>
                                            <div class="right-col">
                                                <select class="form-control cls-select" name="IsActive" id="IsActive" disabled="disabled">
                                                    <option value="1">Active</option>
                                                    <option value="0">Inactive</option>
                                                </select>
                                                <span class="form-text text-muted IsActive">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding-right: 8px;">
                                    <!--begin::Card-->
                                    <div class="card card-custom" style="border: 1px solid #0f2a4b; padding-bottom:10px; margin-top:10px;">
                                        <div class="card-header">
                                            <ol style="font-weight: 700; font-size: 10px; margin-top: 10px;">
                                                <li style="list-style-type: square; float: left; margin-right: 40px;">Password Length : 8 to 15 Char</li>
                                                <li style="list-style-type: square; float: left; margin-right: 40px;">Numeric : 1</li>
                                                <li style="list-style-type: square; float: left;">Letter : 1 small letter & 1 capital letter.</li>
                                            </ol>
                                        </div>

                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                                    <div class="form-group">
                                                        <div class="form-inner8">
                                                            <label class="left-col col-form-label text-lg-right">Password</label>
                                                            <div class="right-col">
                                                                <input type="password" class="form-control" placeholder="" id="PasswordH" name="PasswordH" />
                                                                <span class="form-text text-muted PasswordH">required.</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-xs-12 col-sm-12 col-md-5 col-lg-5">
                                                    <div class="form-group">
                                                        <div class="form-inner14">
                                                            <label class="left-col col-form-label text-lg-right">Confirm Password</label>
                                                            <div class="right-col">
                                                                <input type="password" class="form-control" placeholder="" id="ConfirmPassword" name="ConfirmPassword" />
                                                                <span class="form-text text-muted ConfirmPassword">required.</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!--end::Card-->
                                </div>
                            </div>

                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-lg-6"> </div>
                                    <div class="col-lg-6 text-lg-right">
                                        <div class="btn btn-secondary btn-custom120" id="btnBackToList">Back to List</div>
                                        <div class="btn btn-primary btn-custom" id="btnSave">Save</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section section_footer
    {
    <script src="~/btl/security/userlist.js?version=@version"></script> 
}

