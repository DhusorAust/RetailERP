        function loginContinue() {
            $.ajax({
                type: "POST",
                url: base + "Security/GetLogin",
                data: { UserName: $("#UserID").val(), PasswordH: $("#PasswordH").val() },
                dataType: "json",
                success: function (data) {
                    console.log(data);
                    if (data.isCompleted == true) {
                        window.location.href = data.redirectUrl;
                    } else {
                        MessageHelper.Warning("Login operation failed.", "Warning");
                    }
                },
                error: function (req, status, error) {
                    MessageHelper.Warning(error, "Warning");
                }
            });
        }

        function IsFrmValid() {
            var isValidItem = true;
            if ($('#UserID').val() == "") {
                isValidItem = false;
                $('#Err_UserId').show();
            }
            else {
                $('#Err_UserId').hide();
            }
            if ($('#PasswordH').val() == "") {
                isValidItem = false;
                $('#Err_Password').show();
            }
            else {
                $('#Err_Password').hide();
            }
            if (!isValidItem) {
                ToastrMessageHelper.ValidationToastr("Please fill-up mandatory field.");
            }
            return isValidItem;
        }

        function SetTabIndex(IndexValues) {
            $.each(IndexValues, function (i, obj) {
                i = parseInt(i) + 1;
                $("#" + obj).attr('tabindex', i);
            });
        }
    </script>
