@using wwwReports*@


<script type="text/javascript" id="script">
    function customizeParameterEditors(s, e) {
        if (e.parameter.type === 'System.DateTime') {
            e.info.editor = $.extend({}, e.info.editor);
            e.info.editor.extendedOptions =
                $.extend(e.info.editor.extendedOptions || {},
                    { type: 'date' }, { displayFormat: 'dd-MMM-yyyy' });

        };
    }
</script>


@* @Html.DevExpress().WebDocumentViewer("DocumentViewer").Height("1400px").ExportSettings(settings =>{ settings.ShowPrintNotificationDialog = false;}).Bind(ViewBag.ReportName) *@
@Html.DevExpress().WebDocumentViewer("DocumentViewer").Height("1400px").ClientSideEvents(configure => { configure.CustomizeParameterEditors("customizeParameterEditors"); }).ExportSettings(settings => { settings.ShowPrintNotificationDialog = false; }).Bind(ViewBag.ReportName)

<script>
      function InitDevExWebDocumentViewer(s, e) {
        s.previewModel.reportPreview.zoom(1);
    }
</script>

<style>
    .dx-checkbox-icon {
        width: 22px !important;
