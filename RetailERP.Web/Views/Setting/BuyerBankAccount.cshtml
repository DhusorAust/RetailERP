@{
    var version = Guid.NewGuid().ToString();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section section_top
    {
    <script type="text/javascript">
        localStorage.setItem("pageName", "@ViewBag.PageName");
        localStorage.setItem("menuId", "@ViewBag.MenuId");
    </script>
}
@{
    var pageId = ViewBag.PageName + "-" + ViewBag.MenuId;
    var divToolbarId = "divtoolbar" + pageId;
    var toolbarId = "toolbar" + pageId;
    var tblMasterId = "tbl" + pageId;
    var tblChildId = "tblChild" + pageId;
    var formId = "form" + pageId;
    var divDetailsId = "divDetails" + pageId;
}

<div class="d-flex flex-column-fluid" id="@pageId">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-custom gutter-b example example-compact" style="padding-top:10px;">
                    <div id="@divToolbarId">
                        <div class="row">
                            <div class="col-lg-12">
                                <div id="@toolbarId">
                                    <div class="btn btn-sm fw-bold btn-secondary toolbar-dom" id="btnNewAdd">
                                        <i class="fa fa-plus"></i>&nbsp;New Add
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-primary toolbar-dom" id="btnEditList">
                                        <i class="fa fa-list"></i>&nbsp;Temp List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary toolbar-dom" id="btnApprovedList">
                                        <i class="fa fa-list"></i>&nbsp;Approved List
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div id="@tblMasterId"></div>
                            </div>
                        </div>
                    </div>
                    <form class="form" id="@formId">
                        <input type="hidden" id="BuyerBankAccountID" name="BuyerBankAccountID" value="-1111" />
                     
                        <div class="card-body" id="@divDetailsId" style="display:none"> 

                            <div class="row" style="padding-bottom:10px;"> 


                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner13">
                                            <label class="left-col col-form-label text-lg-right">Buyer</label>
                                            <div class="right-col">
                                                <select class="form-control" id="BuyerID" name="BuyerID">
                                                    <option value="-1">Select</option>
                                                </select>
                                                <span class="form-text text-muted BuyerID">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner13">
                                            <label class="left-col col-form-label text-lg-right">Account Name</label>
                                            <div class="right-col">
                                                <input type="text" class="form-control" placeholder="Bank Account Name" id="BankAccountName" name="BankAccountName" />
                                                <span class="form-text text-muted BankAccountName">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner13">
                                            <label class="left-col col-form-label text-lg-right">Account No</label>
                                            <div class="right-col">
                                                <input type="text" class="form-control" placeholder="Bank Account No" id="BankAccountNo" name="BankAccountNo" />
                                                <span class="form-text text-muted BankAccountNo">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner13">
                                            <label class="left-col col-form-label text-lg-right">Bank</label>
                                            <div class="right-col">
                                                <select class="form-control" id="BankID" name="BankID">
                                                    <option value="-1">Select</option>
                                                </select>
                                                <span class="form-text text-muted BankID">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-inner13">
                                            <label class="left-col col-form-label text-lg-right">Branch</label>
                                            <div class="right-col">
                                                <select class="form-control" id="BankBranchID" name="BankBranchID">
                                                    <option value="-1">Select</option>
                                                </select>
                                                <span class="form-text text-muted BankBranchID">required.</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                             
                            </div>

                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-lg-6"> </div>
                                    <div class="col-lg-6 text-lg-right">
                                        <div class="btn btn-pdlbacktolist btn-custom120 btn-secondary-cs" id="btnBackToList">Back to List</div>
                                        <div class="btn btn-pdlsave btn-custom" id="btnSave"> <i class="fa fa-save"></i> Save</div>
                                        <div class="btn btn-pdlSaveForApprove btn-custom170" id="btnApproved"><i class="fa fa-retweet"></i> Save & Approved</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

 

@section section_footer
    {
    <script src="~/Chem/Setting/BuyerBankAccount.js?version=@version"></script>
}



