@{
    var version = Guid.NewGuid().ToString();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section section_top
{
    <script type="text/javascript">
        localStorage.setItem("pageName", "@ViewBag.PageName");
        localStorage.setItem("menuId", "@ViewBag.MenuId");
    </script>

    <style>
        .file-section {
            background-color: #eef5f2;
            border: 2px solid #b2c9bb;
            border-radius: 6px;
            padding: 10px;
            margin-bottom: 1px;
        }

            .file-section h4 {
                margin-top: 0;
                color: #2f4f4f;
            }

        .file-info {
            margin-top: 1px;
        }

        .btn-view {
            margin-top: 5px;
        }

        .k-grid td.ColoredClass {
            background-color: #73c6b6; /* Light yellow */
        }

        .custom-file-button {
            display: inline-block;
            /*padding: 8px 20px;*/
            background-color: #e9e9e9;
            border: 1px solid #3699ff;
            cursor: pointer;
        }

            /* Optional styling to make it look like a button */
            .custom-file-button:hover {
                background-color: #dcdcdc;
            }

            .custom-file-button:active {
                background-color: #bcbcbc;
            }

        i.fa.fa-solid.fa-upload {
            color: #007385;
        }

    </style>
}
@{
