@{
    var version = Guid.NewGuid().ToString();
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Product Category";
}
@section section_top
{
    <script type="text/javascript">
        localStorage.setItem("pageName", "@ViewBag.PageName");
        localStorage.setItem("menuId", "@ViewBag.MenuId");
    </script>
    <style type="text/css">
        .k-grid .k-hierarchy-col {
            width: 10px;
        }

        #tblLCInformation-69 {
            font-size: 12px;
        }
    </style>

}
@{
    var pageId = ViewBag.PageName + "-" + ViewBag.MenuId;
    var divToolbarId = "divtoolbar" + pageId;
    var toolbarId = "toolbar" + pageId;
    var tblMasterId = "tbl" + pageId;
    var tblChildId = "tblChild" + pageId;
    var formId = "form" + pageId;
    var divDetailsId = "divDetails" + pageId;
}

<div class="d-flex flex-column-fluid" id="@pageId">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-custom gutter-b example example-compact" style="padding-top:10px;">
                    <div id="@divToolbarId">
                        <div class="row">
                            <div class="col-lg-12">
                                <div id="@toolbarId">
                                    <div class="btn btn-sm fw-bold btn-secondary toolbar-dom" id="btnNewAdd">
                                        <i class="fa fa-plus"></i>&nbsp;New Add
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-primary toolbar-dom" id="btnEditList">
                                        <i class="fa fa-list"></i>&nbsp;Temp List
                                    </div>

                                    <div class="btn btn-sm fw-bold btn-secondary" style="border-radius: 0px;" id="btnApprovedList">
                                        <i class="fa fa-list"></i>&nbsp;Approve List
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div id="@tblMasterId"></div>
                            </div>
                        </div>
                    </div>

                    <form class="form" id="@formId">
                        <input type="hidden" id="ProductTypeID" name="ProductTypeID" value="-1111" />

                        <div class="card-body" id="@divDetailsId" style="display:none">
                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; General Information
                                </h6>
                            </div>

                            <div class="k-block p-4" style="border:1px solid #008093; border-radius:0px !important;">
                                <div class="row" style="padding-bottom:10px;">  
                                    <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner11">
                                                <label class="left-col col-form-label text-lg-right">Product Type</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="ProductTypeName" name="ProductTypeName" />
                                                    <span class="form-text text-muted ProductTypeName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner7">
                                                <label class="left-col col-form-label text-lg-right">Remarks</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="Remarks" name="Remarks" />
                                                    <span class="form-text text-muted Remarks">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner7">
                                                <label class="left-col col-form-label text-lg-right">Status</label>
                                                <div class="right-col">
                                                    <select class="form-control cls-select" name="IsActive" id="IsActive">
                                                        <option value="1">Active</option>
                                                        <option value="0">Inactive</option>
                                                    </select>
                                                    <span class="form-text text-muted IsActive">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                </div>
                            </div>

                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-lg-6"> </div>
                                    <div class="col-lg-6 text-lg-right">
                                        <div class="btn btn-sm btn-pdlbacktolist btn-custom120 btn-secondary-cs" id="btnBackToList">Back to List</div>
                                        <div class="btn btn-sm btn-pdlsave btn-custom" id="btnSave"> <i class="fa fa-save"></i> Save</div>
                                        <div class="btn btn-sm btn-pdlSaveForApprove btn-custom170" id="btnApproved"><i class="fa fa-retweet"></i> Save & Approved</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>



@section section_footer
{
    <script src="~/Chem/Setting/Store/ChemicalStore/ProductType.js?version=@version"></script>
}

