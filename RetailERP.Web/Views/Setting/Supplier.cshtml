@{
    var version = Guid.NewGuid().ToString();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section section_top
{
    <script type="text/javascript">
        localStorage.setItem("pageName", "@ViewBag.PageName");
        localStorage.setItem("menuId", "@ViewBag.MenuId");
    </script>
}
@{
    var pageId = ViewBag.PageName + "-" + ViewBag.MenuId;
    var divToolbarId = "divtoolbar" + pageId;
    var toolbarId = "toolbar" + pageId;
    var tblMasterId = "tbl" + pageId;
    var tblChildId = "tblChild" + pageId;
    var formId = "form" + pageId;
    var divDetailsId = "divDetails" + pageId;
}

<div class="d-flex flex-column-fluid" id="@pageId">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="card card-custom gutter-b example example-compact" style="padding-top:10px;">
                    <div id="@divToolbarId">
                        <div class="row">
                            <div class="col-lg-12">
                                <div id="@toolbarId">
                                    <div class="btn btn-sm fw-bold btn-secondary toolbar-dom" id="btnNewAdd">
                                        <i class="fa fa-plus"></i>&nbsp;New Add
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-primary toolbar-dom" id="btnEditList">
                                        <i class="fa fa-list"></i>&nbsp;Temp List
                                    </div>
                                    <div class="btn btn-sm fw-bold btn-secondary toolbar-dom" id="btnApprovedList">
                                        <i class="fa fa-list"></i>&nbsp;Approved List
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div id="@tblMasterId"></div>
                            </div>
                        </div>
                    </div>
                    <form class="form" id="@formId">
                        <input type="hidden" id="SupplierID" name="SupplierID" value="-1111" />

                        <div class="card-body" id="@divDetailsId" style="display:none">
                            <div class="k-block mb-1" style="padding: 5px !important; border-radius: 0px !important;">
                                <h6 class="card-title" style="margin-bottom:0px; padding-bottom:0px;">
                                    <i class="fa fa-cogs text-info text-primary">
                                    </i> &nbsp; General Information
                                </h6>
                            </div>

                            <div class="k-block p-4" style="border:1px solid #008093; border-radius:0px !important;"> 
                                <div class="row" style="padding-bottom:10px;">
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right"> Supplier Name</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="SupplierName" name="SupplierName" />
                                                    <span class="form-text text-muted SupplierName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right"> Short Name</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="ShortSupplierName" name="ShortSupplierName" />
                                                    <span class="form-text text-muted ShortSupplierName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right"> Phone</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="Phone" name="Phone" />
                                                    <span class="form-text text-muted Phone">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right"> Mobile No</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="MobileNo" name="MobileNo" />
                                                    <span class="form-text text-muted MobileNo">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right"> Email</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="Email" name="Email" />
                                                    <span class="form-text text-muted Email">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right"> Website</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="Website" name="Website" />
                                                    <span class="form-text text-muted Website">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Country</label>
                                                <div class="right-col">
                                                    <input type="text" kendorole="combobox" id="CountryID" name="CountryID" style="width:100%; " />
                                                    <span class="form-text text-muted CountryID">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right"> Owner Name</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="OwnerName" name="OwnerName" />
                                                    <span class="form-text text-muted OwnerName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right"> Owner Contact No</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="OwnerContactNo" name="OwnerContactNo" />
                                                    <span class="form-text text-muted OwnerContactNo">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right"> Contact Person</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="ContactPersonName" name="ContactPersonName" />
                                                    <span class="form-text text-muted ContactPersonName">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right"> Contact No</label>
                                                <div class="right-col">
                                                    <input type="text" class="form-control" placeholder="" id="ContactNo" name="ContactNo" />
                                                    <span class="form-text text-muted ContactNo">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Address</label>
                                                <div class="right-col">
                                                    <textarea id="Address" class="form-control" name="Address" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted Address">.</span>
                                                </div>
                                            </div>
                                        </div>
									</div>
									<div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
										<div class="form-group">
											<div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Terms & Conditions</label>
												<div class="right-col">
                                                    <textarea id="TermsNConditions" class="form-control" name="TermsNConditions" rows="1" cols="20" autocomplete="on"></textarea>
                                                    <span class="form-text text-muted TermsNConditions">.</span>
												</div>
											</div>
										</div>
									</div>
                                    <div class="col-xs-12 col-sm-3 col-md-3 col-lg-4">
                                        <div class="form-group">
                                            <div class="form-inner13">
                                                <label class="left-col col-form-label text-lg-right">Status</label>
                                                <div class="right-col">
                                                    <select class="form-control cls-select" name="IsActive" id="IsActive" disabled>
                                                        <option value="1">Active</option>
                                                        <option value="0">Inactive</option>
                                                    </select>
                                                    <span class="form-text text-muted IsActive">required.</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div> 
                                </div>  
                            </div>

                            <div class="card-footer">
                                <div class="row">
                                    <div class="col-lg-6"> </div>
                                    <div class="col-lg-6 text-lg-right">
                                        <div class="btn btn-sm btn-pdlbacktolist btn-custom120 btn-secondary-cs" id="btnBackToList">Back to List</div>
                                        <div class="btn btn-sm btn-pdlsave btn-custom" id="btnSave"> <i class="fa fa-save"></i> Save</div>
                                        <div class="btn btn-sm btn-pdlSaveForApprove btn-custom170" id="btnApproved"><i class="fa fa-retweet"></i> Save & Approved</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section section_footer
{
    <script src="~/chem/setting/Supplier.js?version=@version"></script>
}
